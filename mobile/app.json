{
  "expo": {
    "name": "Ghar Ke Nuskhe",
    "slug": "herbal-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#13665A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.herbalapp.gharkenuskhe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#13665A"
      },
      "package": "com.habuild.gharkenuskhe",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "color": "#13665A"
        }
      ],
      "./plugins/withFirebaseMessagingManifestFix"
    ],
    "extra": {
      "apiUrl": "https://gkn-api.vps.sarvinshrivastava.space",
      "eas": {
        "projectId": "8379f92b-8ede-497d-b21c-2678647b2f8d"
      }
    },
    "owner": "9777797790"
  }
}
