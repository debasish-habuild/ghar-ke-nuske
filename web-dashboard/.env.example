# Base URL of the Go backend the dashboard talks to.
# Local dev defaults to http://localhost:8080 if unset.
# For the deployed dashboard, set this to your PUBLIC backend URL in Vercel.
VITE_API_URL=http://localhost:8080

# NOTE: image uploads no longer need any client-side secret. The dashboard calls
# the backend's auth-protected POST /api/upload-url, which holds the file-service
# token server-side (FILE_SERVICE_TOKEN in the backend's own env on the VPS).
