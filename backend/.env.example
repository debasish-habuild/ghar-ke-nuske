# Copy to .env and fill in. .env is gitignored.

# Firebase / GCP project that owns the Firestore database.
FIREBASE_PROJECT_ID=ghar-ke-nuske-dev

# Absolute path to the service-account JSON key (Admin SDK credentials).
# The Firebase Admin SDK reads this automatically.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# HTTP port the API listens on (optional, defaults to 8080).
PORT=8080
